{
  "name": "volunteer-server",
  "version": "0.1.0",
  "private": true,
  "description": "志愿活动信息平台 · 同步服务（Node.js）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:imports": "node scripts/check-imports.mjs",
    "check:hardcode": "node scripts/check-hardcoded.mjs",
    "check": "npm run check:imports && npm run check:hardcode && npm test"
  },
  "dependencies": {},
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  }
}
