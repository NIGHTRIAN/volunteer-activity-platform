# 包管理配置。
#
# 本机的 `npm` 实际是 pnpm 的包装（`pnpm help install` 出现在 npm 的输出里），
# 因此这里用 pnpm 认识的配置键。
#
# 用国内镜像：直连 registry.npmjs.org 实测约 900ms，镜像约 200ms。
registry=https://registry.npmmirror.com

# 依赖版本写入 lockfile 前先做一致性校验，避免"我这儿能跑"。
strict-peer-dependencies=false
auto-install-peers=true

# esbuild 需要执行安装脚本（它下载平台专用的二进制）。
#
# pnpm 默认阻止依赖执行安装脚本（这是好的默认值：防供应链攻击），
# 但 esbuild 是 **Vite 的必需依赖**，不执行它的脚本就没法构建 ——
# 实测表现为 `vite build` 直接失败。
#
# 这里只放行这一个包，**不要**用 `--allow-all` 之类的开关：
# 那会把所有依赖的脚本都放行，失去保护意义。
onlyBuiltDependencies[]=esbuild
