# 配置模板 —— 复制为 .env 后按需修改。
#
#   cp .env.example .env
#
# 方案 §8.1 的可移植性要求：
#   > 服务端地址、端口、凭据全部走配置（环境变量 / .env）；
#   > 代码中**不得硬编码**域名、IP、端口
#
# 因此本文件是"换环境要改什么"的**唯一清单**。
# 每一个变量都由 `server/src/config.js` 读取，别处不直接读环境变量。
#
# ⚠️ `.env` 里会有真实凭据，**不要提交到版本库**（见 .gitignore）。

# ══════════════════════════════════════════════════════════════════════
# 服务
# ══════════════════════════════════════════════════════════════════════

# 监听地址。
#   dev  ：0.0.0.0（让同一局域网内的手机能访问，真机测试需要）
#   prod ：0.0.0.0（在 Nginx 后面；由 Nginx 对外，此端口不暴露公网）
HOST=0.0.0.0

# 同步服务端口。方案 §8.2 默认 8080，且**仅内网**、可配置。
# 改这里 + 重启即生效，不需要改代码。
PORT=8080

# 运行环境：dev / test / prod
# prod 下会强制要求 TOKEN_SECRET 足够长、且 CORS_ORIGIN 不能是 *
NODE_ENV=dev

# ══════════════════════════════════════════════════════════════════════
# 存储
# ══════════════════════════════════════════════════════════════════════

# 驱动：sqlite / mysql
#
#   sqlite —— 零依赖，单文件。适合本地开发与单机小规模部署。
#             不需要 Docker、不需要装 MySQL，clone 下来即可跑。
#   mysql  —— 方案 §3 指定的生产数据库。
#
# 两者用**同一套业务代码**（存储抽象层），切换只改这一行。
DB_DRIVER=sqlite

# ── SQLite ────────────────────────────────────────────────────────────
# 数据文件路径。目录不存在会自动创建。
DB_SQLITE_FILE=./data/volunteer.db

# ── MySQL（DB_DRIVER=mysql 时必填）────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=volunteer
# ⚠️ 没有默认值：留空会让服务**拒绝启动**（见 config.js 的 validateConfig）。
# 一个悄悄生效的弱口令比启动失败危险得多。
DB_PASSWORD=
DB_DATABASE=volunteer
DB_CONNECTION_LIMIT=10

# ══════════════════════════════════════════════════════════════════════
# 鉴权
# ══════════════════════════════════════════════════════════════════════

# 管理端邀请码。
#
# 方案 §12.1 已定：**默认 1111，且不强制更换**，
# 依赖 ownerId 隔离 + 设备指纹绑定 + 登录审计兜底。
# 所以这里给 1111 是**照方案执行**，不是疏忽。
#
# 但它确实是一个公开的默认口令，因此：
#   * 生产环境建议改掉（改这里一行即可，不需要改代码）；
#   * 无论是否改，都不要去掉设备指纹校验与失败锁定。
ADMIN_INVITE_CODE=1111

# ── 多发布者（可选）────────────────────────────────────────────────────
#
# 多个组织共用一个服务端时，用「邀请码:发布者ID」把它们分开。
# 每个码登录后只看到、只能改自己名下的活动；网页端（匿名）仍能看到全部已发布活动。
#
# 格式：逗号分隔的 `码:ownerId`。不配时退化为单发布者（上面那个 ADMIN_INVITE_CODE）。
#
# ⚠️ 两条使用约定：
#   1. 码按组织分发，不要共用 —— 共用等于两个部门互相能改对方的活动；
#   2. 换组织要换码（而不是只改映射），否则旧码持有者会接管新身份的活动。
#
# 例：ADMIN_OWNERS="1111:owner-demo-0001,2222:owner-org-b,3333:owner-org-c"
# ADMIN_OWNERS=

# 令牌有效期（分钟）。默认 12 小时。
#
# 实际是**滑动过期**：剩余不足 1/4 时，只要有请求就自动续到满 TTL。
# 所以"一直在用"的管理端不会中途掉登录，真正闲置 12 小时才会失效。
ADMIN_TOKEN_TTL_MINUTES=720

# 名下活动全部终结后，令牌保留多少小时（默认 24）。
ADMIN_TOKEN_TERMINAL_GRACE_HOURS=24

# 连续失败多少次锁定、锁多久（分钟）。
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# 令牌签名密钥。
#
# ⚠️ dev/test 可以留空（会用开发默认值并在启动时告警）；
#    NODE_ENV=prod 时**必须**填，且不少于 32 字符，否则拒绝启动。
#    生成方法：openssl rand -base64 48
TOKEN_SECRET=

# ══════════════════════════════════════════════════════════════════════
# 其他
# ══════════════════════════════════════════════════════════════════════

# 单请求体上限（字节）。默认 8MB，够导入大名单。
MAX_BODY_BYTES=8388608

# 是否输出访问日志。
ACCESS_LOG=true

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# CORS 允许来源。
#
# ⚠️ 默认 `*` 只适合开发。**生产必须指定具体来源**，否则
#    任何网站都能从用户浏览器直接调用本服务。
#
# 之所以开发期可以是 `*`：开发时前端通过 Vite 代理访问（同源），
# 本来就碰不到 CORS；真机测试用的是 App，也不受 CORS 限制。
# 生产环境是前后端同域（方案 §8.2），同样不需要放宽 CORS。
CORS_ORIGIN=*

# ══════════════════════════════════════════════════════════════════════
# 前端（仅开发期；生产由 Nginx 转发，产物里不含这些值）
# ══════════════════════════════════════════════════════════════════════

# Vite 开发服务器的代理目标。改这里可以指向真实服务端而不动前端代码。
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Vite 开发服务器端口。方案 §8.2 默认 8888；这里用 5173（Vite 惯例），
# 同样可配置。
VITE_PORT=5173
